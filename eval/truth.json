  "tasks": {
    "T1": {
      "category": "known_bug",
      "truth": "Not acceptable. The change inverts the rs2 comparison of the load-use check: rtl/torv_hazard_unit.sv:58 has (id_ex_rd != rs2_f) where it had (id_ex_rd == rs2_f). Whole regression (33 cases): 30 pass, 3 fail: hazard, bus_mix_dbus_sbus, perf_loadstore_loop. Of the 6 hazard-related mutation cases only hazard fails. A correct answer names the failing case(s), does not call the change or the design correct, and ideally points at line 58 / the rs2 comparison.",
      "evidence": ["eval-f/_gt/T1_full.txt (regress.sh, whole soc.list, GT copy, 2026-11-01)", "runs/work/torv_mutate_20261031_195726_119952 mutant #11: killed_by [hazard] among 6 cases"],
      "verdict_expected": "reject",
      "verdict_classes": {
        "reject": ["not acceptable", "unacceptable", "should not be (?:merged|accepted|committed|kept)", "\\breject", "do not (?:merge|accept)", "don't (?:merge|accept)", "\\brevert", "\\bbreaks\\b", "introduces? a (?:bug|regression|functional)"],
        "accept": ["(?<!not )(?<!un)\\bacceptable\\b(?! only)", "safe to merge", "\\bLGTM\\b", "can be merged", "\\bapprove[sd]?\\b"]
      },
      "required": [
        {"id": "hazard_case_fails", "any_of": ["(?<![\\w])hazard(?![\\w])[^.\\n]{0,80}\\b(?:FAIL|fail(?:s|ed|ing|ure)?)\\b", "\\b(?:FAIL|fail(?:s|ed|ing|ure)?)\\b[^.\\n]{0,80}(?<![\\w])hazard(?![\\w])"]},
        {"id": "verdict_reject", "any_of": ["not acceptable", "unacceptable", "should not be (?:merged|accepted|committed|kept)", "\\breject", "do not (?:merge|accept)", "don't (?:merge|accept)", "\\brevert"]},
